# Leave empty in local dev to use Vite proxy (/api → localhost:8000)
# VITE_API_BASE_URL=http://localhost:8000

# Writer id used for POST /v1/studio/start-session
VITE_WRITER_ID=ui-writer

# Optional default ElevenLabs voice for all characters
# VITE_DEFAULT_VOICE_ID=

# Optional proxy target override
# VITE_API_PROXY_TARGET=http://localhost:8000
